<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base MD3 Light Theme -->
    <style name="Theme.MyApplication" parent="Theme.Material3.Light.NoActionBar">
        <!-- Primary -->
        <item name="colorPrimary">@color/primary</item>
        <item name="colorOnPrimary">@color/onPrimary</item>
        <item name="colorPrimaryContainer">@color/primaryContainer</item>
        <item name="colorOnPrimaryContainer">@color/onPrimaryContainer</item>

        <!-- Secondary -->
        <item name="colorSecondary">@color/secondary</item>
        <item name="colorOnSecondary">@color/onSecondary</item>
        <item name="colorSecondaryContainer">@color/secondaryContainer</item>
        <item name="colorOnSecondaryContainer">@color/onSecondaryContainer</item>

        <!-- Tertiary -->
        <item name="colorTertiary">@color/tertiary</item>
        <item name="colorOnTertiary">@color/onTertiary</item>
        <item name="colorTertiaryContainer">@color/tertiaryContainer</item>
        <item name="colorOnTertiaryContainer">@color/onTertiaryContainer</item>

        <!-- Error -->
        <item name="colorError">@color/error</item>
        <item name="colorOnError">@color/onError</item>
        <item name="colorErrorContainer">@color/errorContainer</item>
        <item name="colorOnErrorContainer">@color/onErrorContainer</item>

        <!-- Surface -->
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/onSurface</item>
        <item name="colorSurfaceVariant">@color/surfaceVariant</item>
        <item name="colorOnSurfaceVariant">@color/onSurfaceVariant</item>
        <item name="colorSurfaceContainerLowest">@color/surfaceContainerLowest</item>
        <item name="colorSurfaceContainerLow">@color/surfaceContainerLow</item>
        <item name="colorSurfaceContainer">@color/surfaceContainer</item>
        <item name="colorSurfaceContainerHigh">@color/surfaceContainerHigh</item>
        <item name="colorSurfaceContainerHighest">@color/surfaceContainerHighest</item>

        <!-- Background -->
        <item name="android:colorBackground">@color/background</item>
        <item name="colorOnBackground">@color/onBackground</item>

        <!-- Outline -->
        <item name="colorOutline">@color/outline</item>
        <item name="colorOutlineVariant">@color/outlineVariant</item>

        <!-- System bars -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>

        <!-- Enable edge-to-edge -->
        <item name="android:windowTranslucentNavigation">false</item>
    </style>

    <!-- MD3 DayNight (auto dark mode) -->
    <style name="Theme.MyApplication.DayNight" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorOnPrimary">@color/onPrimary</item>
        <item name="colorSecondary">@color/secondary</item>
        <item name="colorTertiary">@color/tertiary</item>
        <item name="colorError">@color/error</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <!-- MaterialToolbar style -->
    <style name="ToolbarStyle" parent="Widget.Material3.Toolbar">
        <item name="android:background">@color/surface</item>
        <item name="titleTextColor">@color/onSurface</item>
        <item name="android:elevation">0dp</item>
    </style>

    <!-- MD3 Card -->
    <style name="CardStyle" parent="Widget.Material3.CardView.Filled">
        <item name="cardCornerRadius">24dp</item>
        <item name="cardElevation">1dp</item>
        <item name="cardBackgroundColor">@color/surface</item>
        <item name="strokeWidth">0dp</item>
        <item name="contentPadding">20dp</item>
    </style>

    <!-- Overlay Tab 文字样式 -->
    <style name="TabTextStyle" parent="TextAppearance.Design.Tab">
        <item name="android:textSize">13sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <!-- Nav label styles — MD3 Label Large -->
    <style name="NavLabelActive">
        <item name="android:textSize">12sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0.01</item>
    </style>

    <style name="NavLabelInactive">
        <item name="android:textSize">12sp</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:letterSpacing">0.01</item>
    </style>

    <!-- Active indicator — wraps icon + label -->
    <style name="NavActiveIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="cornerRadius">18dp</item>
    </style>

    <!-- Section title -->
    <style name="SectionTitle">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/onSurfaceVariant</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:paddingBottom">8dp</item>
    </style>

    <!-- Location card label -->
    <style name="LocationLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">26dp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:textColor">@color/onSurfaceVariant</item>
        <item name="android:textSize">12sp</item>
        <item name="android:singleLine">true</item>
    </style>

    <!-- Location card value -->
    <style name="LocationValue">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">26dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:textColor">@color/onSurface</item>
        <item name="android:textSize">12sp</item>
        <item name="android:singleLine">true</item>
        <item name="android:ellipsize">end</item>
    </style>

    <!-- Modern button -->
    <style name="ModernButton" parent="Widget.Material3.Button">
        <item name="cornerRadius">28dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <!-- Splash screen theme (no action bar, solid status bar) -->
    <style name="Theme.MyApplication.NoActionBar" parent="Theme.MyApplication">
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <!-- Legacy overlay styles for backward compatibility -->
    <style name="Theme.MyApplication.AppBarOverlay" parent="ThemeOverlay.AppCompat.Dark.ActionBar" />
    <style name="Theme.MyApplication.PopupOverlay" parent="ThemeOverlay.AppCompat.Light" />

    <!-- 定位页面信息面板 Section 标题 -->
    <style name="InfoSectionTitle">
        <item name="android:textSize">11sp</item>
        <item name="android:textColor">@color/onSurfaceVariant</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0.05</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">6dp</item>
        <item name="android:paddingStart">4dp</item>
        <item name="android:textAllCaps">true</item>
    </style>

    <!-- 定位页面信息面板子卡片 -->
    <style name="InfoSubCard" parent="Widget.Material3.CardView.Filled">
        <item name="cardCornerRadius">10dp</item>
        <item name="cardElevation">0dp</item>
        <item name="cardBackgroundColor">@color/surfaceContainerLow</item>
        <item name="strokeWidth">0dp</item>
        <item name="contentPadding">0dp</item>
    </style>

    <!-- 星空图星座统计标签 -->
    <style name="SkyStatLabel">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:gravity">center</item>
        <item name="android:textSize">10sp</item>
        <item name="android:fontFamily">monospace</item>
    </style>

    <!-- 模式选择 Chip — 胶囊形，选中蓝色填充 -->
    <style name="ModeChip" parent="Widget.Material3.Chip.Filter">
        <item name="android:layout_height">32dp</item>
        <item name="android:checkable">true</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/mode_chip_text</item>
        <item name="chipBackgroundColor">@color/mode_chip_bg</item>
        <item name="chipStrokeColor">@color/mode_chip_stroke</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="chipCornerRadius">16dp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:layout_marginHorizontal">2dp</item>
        <item name="android:gravity">center</item>
        <item name="android:ellipsize">none</item>
        <item name="chipMinTouchTargetSize">0dp</item>
        <item name="android:textAlignment">center</item>
    </style>

    <!-- 底部抽屉面板 行容器 -->
    <style name="BottomSheetRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:paddingVertical">4dp</item>
    </style>

    <!-- 底部抽屉面板 Section 标题 -->
    <style name="BottomSheetSection">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textColor">@color/pos_sheet_section</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">4dp</item>
    </style>

    <!-- 底部抽屉面板 Label -->
    <style name="BottomSheetLabel">
        <item name="android:layout_width">48dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/pos_sheet_label</item>
    </style>

    <!-- 底部抽屉面板 Value -->
    <style name="BottomSheetValue">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/pos_sheet_value</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:ellipsize">end</item>
        <item name="android:singleLine">true</item>
    </style>

    <!-- 底部抽屉面板 次要文本 -->
    <style name="BottomSheetSub">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textColor">@color/pos_sheet_sub</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:ellipsize">end</item>
        <item name="android:singleLine">true</item>
        <item name="android:paddingStart">54dp</item>
    </style>

    <!-- 定位页面底部面板指标值 -->
    <style name="MetricValue">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/pos_sheet_value</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:gravity">center</item>
        <item name="android:singleLine">true</item>
    </style>

    <!-- 定位页面底部面板指标标签 -->
    <style name="MetricLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">10sp</item>
        <item name="android:textColor">@color/pos_sheet_label</item>
        <item name="android:gravity">center</item>
        <item name="android:singleLine">true</item>
    </style>

    <!-- 定位页面底部面板 — 解算详情值（较小，较淡） -->
    <style name="InfoValue">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">10sp</item>
        <item name="android:textColor">@color/pos_sheet_label</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:gravity">center</item>
        <item name="android:singleLine">true</item>
        <item name="android:ellipsize">end</item>
    </style>

    <!-- 定位页面底部面板 — 解算详情标签 -->
    <style name="InfoLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">9sp</item>
        <item name="android:textColor">@color/pos_sheet_label</item>
        <item name="android:gravity">center</item>
        <item name="android:singleLine">true</item>
    </style>

    <!-- 解算详情卡片 — 浅灰底色+细描边，与白色页面区分 -->
    <style name="DetailCard" parent="Widget.Material3.CardView.Filled">
        <item name="cardCornerRadius">14dp</item>
        <item name="cardElevation">0dp</item>
        <item name="cardBackgroundColor">@color/surfaceContainerLow</item>
        <item name="strokeWidth">0.5dp</item>
        <item name="strokeColor">@color/outlineVariant</item>
        <item name="contentPadding">16dp</item>
    </style>

    <!-- 解算详情卡片内 Section 标题 -->
    <style name="DetailSectionTitle">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/onSurfaceVariant</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:paddingBottom">8dp</item>
    </style>

    <!-- 引导向导圆点 -->
    <style name="GuideDot">
        <item name="android:layout_width">8dp</item>
        <item name="android:layout_height">8dp</item>
        <item name="android:layout_marginHorizontal">4dp</item>
    </style>

</resources>

<?xml version="1.0" encoding="utf-8"?>
<!-- 定位页面 — GNSS UI -->
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark_page"
    tools:context=".PositioningFragment">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- ═══ 顶部卡片 ═══ -->
        <LinearLayout
            android:id="@+id/top_card"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:layout_marginHorizontal="8dp"
            android:layout_marginTop="4dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:elevation="4dp"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp">

            <LinearLayout
                android:id="@+id/info_bar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingVertical="2dp">

                <LinearLayout
                    android:id="@+id/info_eph_section"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:paddingVertical="2dp"
                    android:paddingHorizontal="4dp">
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">
                        <View android:id="@+id/info_eph_dot"
                            android:layout_width="7dp" android:layout_height="7dp"
                            android:layout_marginEnd="4dp"
                            android:background="@drawable/status_dot" />
                        <TextView android:id="@+id/info_eph_status"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/pos_eph"
                            android:textColor="@color/pos_sheet_value"
                            android:textSize="11sp"
                            android:fontFamily="sans-serif-medium" />
                    </LinearLayout>
                    <TextView android:id="@+id/info_eph_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:textColor="@color/pos_sheet_sub"
                        android:textSize="9sp"
                        android:maxLines="1"
                        android:ellipsize="end" />
                </LinearLayout>

                <View android:layout_width="1dp" android:layout_height="22dp"
                    android:background="@color/outlineVariant" />

                <LinearLayout
                    android:id="@+id/info_cors_section"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:paddingVertical="2dp"
                    android:paddingHorizontal="4dp">
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">
                        <View android:id="@+id/info_cors_dot"
                            android:layout_width="7dp" android:layout_height="7dp"
                            android:layout_marginEnd="4dp"
                            android:background="@drawable/status_dot" />
                        <TextView android:id="@+id/info_cors_status"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="CORS"
                            android:textColor="@color/pos_sheet_value"
                            android:textSize="11sp"
                            android:fontFamily="sans-serif-medium" />
                    </LinearLayout>
                    <TextView android:id="@+id/info_cors_sub"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="NTRIP"
                        android:textColor="@color/pos_sheet_sub"
                        android:textSize="9sp" />
                </LinearLayout>

                <View android:layout_width="1dp" android:layout_height="22dp"
                    android:background="@color/outlineVariant" />

                <LinearLayout
                    android:id="@+id/info_rtcm_section"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:paddingVertical="2dp"
                    android:paddingHorizontal="4dp">
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">
                        <View android:id="@+id/info_rtcm_dot"
                            android:layout_width="7dp" android:layout_height="7dp"
                            android:layout_marginEnd="4dp"
                            android:background="@drawable/status_dot" />
                        <TextView android:id="@+id/info_rtcm_status"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="RTCM"
                            android:textColor="@color/pos_sheet_value"
                            android:textSize="11sp"
                            android:fontFamily="sans-serif-medium" />
                    </LinearLayout>
                    <TextView android:id="@+id/info_rtcm_bytes"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:textColor="@color/pos_sheet_sub"
                        android:textSize="9sp" />
                </LinearLayout>

            </LinearLayout>

            <!-- 星历详情展开区域 — 默认隐藏 -->
            <LinearLayout
                android:id="@+id/eph_detail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                android:paddingHorizontal="8dp"
                android:paddingBottom="4dp">

                <View
                    android:layout_width="match_parent"
                    android:layout_height="0.5dp"
                    android:background="@color/outlineVariant"
                    android:layout_marginVertical="2dp" />

                <TextView
                    android:id="@+id/eph_detail_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/pos_sheet_value"
                    android:textSize="11sp"
                    android:fontFamily="monospace"
                    android:lineSpacingExtra="2dp"
                    android:text="" />

                <!-- 星历模式选择 — 展开后可见 -->
                <!-- 已移至解算配置Tab -->

                <View
                    android:layout_width="match_parent"
                    android:layout_height="0.5dp"
                    android:background="@color/outlineVariant"
                    android:layout_marginTop="4dp" />

                <TextView
                    android:id="@+id/eph_next_update"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/pos_sheet_sub"
                    android:textSize="10sp"
                    android:layout_marginTop="2dp"
                    android:text="" />
            </LinearLayout>

            <!-- CORS详情展开区域 — 默认隐藏 -->
            <LinearLayout
                android:id="@+id/cors_detail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                android:paddingHorizontal="8dp"
                android:paddingBottom="4dp">

                <View
                    android:layout_width="match_parent"
                    android:layout_height="0.5dp"
                    android:background="@color/outlineVariant"
                    android:layout_marginVertical="2dp" />

                <TextView
                    android:id="@+id/cors_detail_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/pos_sheet_value"
                    android:textSize="11sp"
                    android:fontFamily="monospace"
                    android:lineSpacingExtra="2dp"
                    android:text="" />
            </LinearLayout>

            <!-- RTCM详情展开区域 — 默认隐藏 -->
            <LinearLayout
                android:id="@+id/rtcm_detail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                android:paddingHorizontal="8dp"
                android:paddingBottom="4dp">

                <View
                    android:layout_width="match_parent"
                    android:layout_height="0.5dp"
                    android:background="@color/outlineVariant"
                    android:layout_marginVertical="2dp" />

                <TextView
                    android:id="@+id/rtcm_detail_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/pos_sheet_value"
                    android:textSize="11sp"
                    android:fontFamily="monospace"
                    android:lineSpacingExtra="2dp"
                    android:text="" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="0.5dp"
                android:background="@color/outlineVariant"
                android:layout_marginVertical="2dp" />

            <LinearLayout
                android:id="@+id/mode_selector"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingVertical="2dp">

                <com.google.android.material.chip.Chip
                    android:id="@+id/mode_spp"
                    style="@style/ModeChip"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:text="SPP"
                    android:checked="true" />
                <com.google.android.material.chip.Chip
                    android:id="@+id/mode_dgnss"
                    style="@style/ModeChip"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:text="DGNSS" />
                <com.google.android.material.chip.Chip
                    android:id="@+id/mode_rtk"
                    style="@style/ModeChip"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:text="RTK" />
                <com.google.android.material.chip.Chip
                    android:id="@+id/mode_ppp"
                    style="@style/ModeChip"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:text="PPP"
                    android:visibility="gone" />

            </LinearLayout>

        </LinearLayout>

        <!-- ═══ 地图容器 — 全屏底图层，延伸到信息栏下方 ═══ -->
        <FrameLayout
            android:id="@+id/map_container"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <!-- 右下缩放/定位/图层按钮组 -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end|bottom"
                android:layout_marginEnd="16dp"
                android:layout_marginBottom="140dp"
                android:orientation="vertical"
                android:elevation="6dp">

                <ImageButton
                    android:id="@+id/btn_zoom_in"
                    android:layout_width="40dp" android:layout_height="40dp"
                    android:background="@drawable/bg_fab"
                    android:src="@drawable/ic_fab_add"
                    android:contentDescription="@string/pos_zoom_in" />
                <ImageButton
                    android:id="@+id/btn_zoom_out"
                    android:layout_width="40dp" android:layout_height="40dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_fab"
                    android:src="@drawable/ic_fab_remove"
                    android:contentDescription="@string/pos_zoom_out" />
                <ImageButton
                    android:id="@+id/btn_locate"
                    android:layout_width="40dp" android:layout_height="40dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_fab"
                    android:src="@drawable/ic_fab_locate"
                    android:contentDescription="@string/pos_locate" />
                <ImageButton
                    android:id="@+id/btn_map_layer"
                    android:layout_width="40dp" android:layout_height="40dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_fab"
                    android:src="@drawable/ic_fab_layer"
                    android:contentDescription="@string/pos_map_layer" />

            </LinearLayout>

        </FrameLayout>

        <!-- ═══ 底部解算卡片（可展开，与顶部卡一致） ═══ -->
        <LinearLayout
            android:id="@+id/bottom_sheet"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:elevation="4dp"
            android:layout_marginHorizontal="8dp"
            android:layout_marginBottom="4dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <!-- 详情区（把手上方，点击把手就地展开/收起，与顶部卡展开一致） -->
            <FrameLayout
                android:id="@+id/sheet_fragment"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:visibility="gone"
                android:paddingTop="4dp">

                <androidx.fragment.app.FragmentContainerView
                    android:id="@+id/sheet_fragment_container"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />
            </FrameLayout>

            <!-- 把手+标题（点击展开/收起） -->
            <FrameLayout
                android:id="@+id/sheet_toolbar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="16dp"
                android:paddingVertical="8dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground">

                <!-- 纬度（收起态左侧） -->
                <TextView
                    android:id="@+id/sheet_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="start|center_vertical"
                    android:text="@string/pos_slide_up"
                    android:textColor="@color/pos_hint"
                    android:textSize="12sp"
                    android:fontFamily="sans-serif-medium" />

                <View
                    android:layout_width="48dp"
                    android:layout_height="4dp"
                    android:layout_gravity="center"
                    android:background="@color/pos_hint" />

                <!-- 经度（收起态右侧） -->
                <TextView
                    android:id="@+id/sheet_lon_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end|center_vertical"
                    android:text="--"
                    android:textColor="@color/pos_hint"
                    android:textSize="12sp"
                    android:fontFamily="sans-serif-medium" />

                <ImageButton
                    android:id="@+id/sheet_close_btn"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_gravity="end|center_vertical"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_close"
                    android:tint="@color/pos_sheet_sub"
                    android:visibility="gone"
                    android:contentDescription="@string/pos_close" />
            </FrameLayout>

            <!-- 指标栏 -->
            <LinearLayout
                android:id="@+id/bottom_metrics"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="8dp"
                android:paddingTop="2dp"
                android:paddingBottom="8dp">

                <View
                    android:layout_width="match_parent"
                    android:layout_height="0.5dp"
                    android:layout_marginVertical="2dp"
                    android:background="@color/outlineVariant" />

                <!-- 指标行 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingVertical="4dp"
                    android:paddingHorizontal="4dp"
                    android:gravity="center">

                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                        <TextView android:id="@+id/metric_val_hacc" style="@style/MetricValue" android:text="-" />
                        <TextView style="@style/MetricLabel" android:text="@string/metric_h" />
                    </LinearLayout>
                    <View android:layout_width="1dp" android:layout_height="32dp" android:background="#33FFFFFF" />

                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                        <TextView android:id="@+id/metric_val_vacc" style="@style/MetricValue" android:text="-" />
                        <TextView style="@style/MetricLabel" android:text="@string/metric_v" />
                    </LinearLayout>
                    <View android:layout_width="1dp" android:layout_height="32dp" android:background="#33FFFFFF" />

                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                        <TextView android:id="@+id/metric_val_speed" style="@style/MetricValue" android:text="-" />
                        <TextView style="@style/MetricLabel" android:text="@string/metric_speed" />
                    </LinearLayout>
                    <View android:layout_width="1dp" android:layout_height="32dp" android:background="#33FFFFFF" />

                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                        <TextView android:id="@+id/metric_val_sat" style="@style/MetricValue" android:text="-" />
                        <TextView style="@style/MetricLabel" android:text="@string/metric_sats" />
                    </LinearLayout>
                    <View android:layout_width="1dp" android:layout_height="32dp" android:background="#33FFFFFF" />

                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                        <TextView android:id="@+id/metric_val_mode" style="@style/MetricValue" android:text="-" />
                        <TextView style="@style/MetricLabel" android:text="@string/metric_mode" />
                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>


</androidx.coordinatorlayout.widget.CoordinatorLayout>
